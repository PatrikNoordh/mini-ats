# Copy to .env.local and fill in. .env.local is never committed.
# Supabase project URL and anon (public) key, from Project Settings → API.
# The service role key never goes here: it lives in Supabase secrets. The demo seed script
# (npm run seed:demo) reads it from your shell or from .env.seed.local, also never committed.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Invites and password reset (ATS-50, ATS-51) show only when this is exactly true. Leave it unset
# unless Auth sends real email: production uses Supabase's built-in email, which only reaches the
# project's team (docs/auth-email.md). The end-to-end build sets it for the local stack.
VITE_EMAIL_ENABLED=
