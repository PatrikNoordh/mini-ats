# Copy to .env.local and fill in. .env.local is never committed.
# Supabase project URL and anon (public) key, from Project Settings → API.
# The service role key never goes here: it lives in Supabase secrets. The demo seed script
# (npm run seed:demo) reads it from your shell or from .env.seed.local, also never committed.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
